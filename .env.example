# Copy to .env.local for local dev.
#
# NOTE: Never commit real secrets. Keep .env.local untracked.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth.js / NextAuth (v5) ────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=
# Recommended for server-side helpers (server actions, middleware, etc.)
AUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Authorised redirect URI:
# - http://localhost:3000/api/auth/callback/google
# (If you run on 3001, also add http://localhost:3001/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

